# Copy this file to .env and fill in your own values.
# NEVER share your .env file or paste your token in chat or in code.
# If a token ever leaks, reset it in the Discord Developer Portal.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: channel ID for the 09:00 briefing and 14:30 US-open post.
# Leave blank to disable scheduled posts.
# To get a channel ID: Discord Settings > Advanced > Developer Mode ON,
# then right-click the channel > Copy Channel ID.
NEWS_CHANNEL_ID=

# Optional: comma-separated tickers for the daily briefing and for
# /earnings and /post_week_ahead when no tickers are given.
# These are major indices by default — edit to your own list.
# WATCHLIST=^GSPC,^FTSE,^IXIC,^DJI,AAPL,MSFT,NVDA
WATCHLIST=
